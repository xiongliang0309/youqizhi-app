import React, { useState, useRef, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { ArrowLeft, Trash2, Save, Palette, Image as ImageIcon, Download } from 'lucide-react';
import confetti from 'canvas-confetti';

const TEMPLATES = [
  {
    id: 'dino',
    name: '小恐龙',
    icon: '🦖',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" fill="none" stroke="#1f2937" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"><path d="M 120 320 L 120 280 C 80 280 60 240 60 180 C 60 100 120 60 200 60 C 280 60 340 120 340 180 C 340 240 320 280 280 280 L 280 320 Z M 160 320 L 160 360 M 240 320 L 240 360 M 140 140 A 10 10 0 1 1 140 142 M 260 140 A 10 10 0 1 1 260 142 M 180 220 Q 200 240 220 220"/></svg>`
  },
  {
    id: 'car',
    name: '小汽车',
    icon: '🚗',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" fill="none" stroke="#1f2937" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"><path d="M 60 240 L 60 200 L 120 120 L 280 120 L 340 200 L 340 240 Z M 40 240 L 360 240 L 360 280 L 40 280 Z"/><circle cx="120" cy="280" r="40" /><circle cx="280" cy="280" r="40" /><path d="M 200 120 L 200 200"/></svg>`
  },
  {
    id: 'flower',
    name: '小花花',
    icon: '🌸',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" fill="none" stroke="#1f2937" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"><circle cx="200" cy="200" r="40" /><path d="M 200 160 C 200 80 160 40 200 40 C 240 40 200 80 200 160 Z" /><path d="M 200 240 C 200 320 160 360 200 360 C 240 360 200 320 200 240 Z" /><path d="M 160 200 C 80 200 40 160 40 200 C 40 240 80 200 160 200 Z" /><path d="M 240 200 C 320 200 360 160 360 200 C 360 240 320 200 240 200 Z" /></svg>`
  },
  {
    id: 'house',
    name: '小房子',
    icon: '🏠',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" fill="none" stroke="#1f2937" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"><path d="M 80 200 L 200 80 L 320 200" /><path d="M 120 200 L 120 340 L 280 340 L 280 200" /><path d="M 180 340 L 180 260 L 220 260 L 220 340" /><rect x="140" y="220" width="30" height="30" /><rect x="230" y="220" width="30" height="30" /></svg>`
  }
];

interface GalleryItem {
  id: string;
  dataUrl: string;
  timestamp: number;
}

type ViewMode = 'home' | 'canvas' | 'gallery';

export const Art: React.FC = () => {
  const navigate = useNavigate();
  const [view, setView] = useState<ViewMode>('home');
  const [selectedTemplate, setSelectedTemplate] = useState<string | null>(null);
  
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const [color, setColor] = useState('#EF4444');
  const [lineWidth, setLineWidth] = useState(12);
  const [isDrawing, setIsDrawing] = useState(false);
  const [gallery, setGallery] = useState<GalleryItem[]>([]);

  useEffect(() => {
    const saved = localStorage.getItem('youqizhi_gallery');
    if (saved) {
      try {
        setGallery(JSON.parse(saved));
      } catch (e) {}
    }
  }, []);

  const saveGallery = (items: GalleryItem[]) => {
    setGallery(items);
    localStorage.setItem('youqizhi_gallery', JSON.stringify(items));
  };

  // 初始化画布
  const initCanvas = () => {
    const canvas = canvasRef.current;
    if (canvas) {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      const ctx = canvas.getContext('2d');
      if (ctx) {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
      }
    }
  };

  useEffect(() => {
    if (view === 'canvas') {
      initCanvas();
      window.addEventListener('resize', initCanvas);
      return () => window.removeEventListener('resize', initCanvas);
    }
  }, [view]);

  const startDrawing = (e: React.MouseEvent | React.TouchEvent) => {
    setIsDrawing(true);
    draw(e);
  };

  const stopDrawing = () => {
    setIsDrawing(false);
    const ctx = canvasRef.current?.getContext('2d');
    if (ctx) ctx.beginPath();
  };

  const draw = (e: React.MouseEvent | React.TouchEvent) => {
    if (!isDrawing) return;
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const rect = canvas.getBoundingClientRect();
    let x, y;

    if ('touches' in e) {
      e.preventDefault(); // 防止滚动
      x = e.touches[0].clientX - rect.left;
      y = e.touches[0].clientY - rect.top;
    } else {
      x = (e as React.MouseEvent).clientX - rect.left;
      y = (e as React.MouseEvent).clientY - rect.top;
    }

    ctx.lineWidth = lineWidth;
    ctx.strokeStyle = color;
    
    ctx.lineTo(x, y);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x, y);
  };

  const clearCanvas = () => {
    const canvas = canvasRef.current;
    const ctx = canvas?.getContext('2d');
    if (canvas && ctx) {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
  };

  const handleSave = () => {
    const canvas = canvasRef.current;
    if (!canvas) return;

    const tempCanvas = document.createElement('canvas');
    tempCanvas.width = canvas.width;
    tempCanvas.height = canvas.height;
    const ctx = tempCanvas.getContext('2d');
    if (!ctx) return;

    // 1. 绘制白色背景
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);

    // 2. 绘制用户涂鸦
    ctx.drawImage(canvas, 0, 0);

    const finishSave = (dataUrl: string) => {
      const newItem: GalleryItem = {
        id: Date.now().toString(),
        dataUrl,
        timestamp: Date.now()
      };
      saveGallery([newItem, ...gallery]);
      
      confetti({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 },
        colors: ['#FFC107', '#00BCD4', '#E91E63', '#4CAF50']
      });
      
      setTimeout(() => {
        setView('gallery');
      }, 1000);
    };

    // 3. 绘制线稿（如果有）
    if (selectedTemplate) {
      const template = TEMPLATES.find(t => t.id === selectedTemplate);
      if (template) {
        const img = new Image();
        img.onload = () => {
          // 使用正片叠底模式将线稿印上去
          ctx.globalCompositeOperation = 'multiply';
          ctx.drawImage(img, 0, 0, tempCanvas.width, tempCanvas.height);
          finishSave(tempCanvas.toDataURL('image/png'));
        };
        img.src = \`data:image/svg+xml;charset=utf-8,\${encodeURIComponent(template.svg)}\`;
        return;
      }
    }

    finishSave(tempCanvas.toDataURL('image/png'));
  };

  const deleteItem = (id: string) => {
    saveGallery(gallery.filter(item => item.id !== id));
  };

  const colors = ['#000000', '#ffffff', '#EF4444', '#F97316', '#EAB308', '#22C55E', '#3B82F6', '#A855F7', '#EC4899', '#8B5CF6'];

  const renderHome = () => (
    <div className="flex-1 p-6 overflow-y-auto">
      <div className="max-w-4xl mx-auto space-y-8">
        <div className="bg-gradient-to-r from-purple-100 to-pink-100 rounded-3xl p-8 text-center shadow-sm">
          <h3 className="text-2xl font-black text-gray-800 mb-4">今天想画点什么呢？</h3>
          <div className="flex justify-center gap-4">
            <button 
              onClick={() => { setSelectedTemplate(null); setView('canvas'); }}
              className="bg-white px-8 py-4 rounded-2xl font-bold text-lg text-purple-600 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all flex items-center gap-2"
            >
              <Palette size={24} />
              自由创作
            </button>
            <button 
              onClick={() => setView('gallery')}
              className="bg-purple-600 px-8 py-4 rounded-2xl font-bold text-lg text-white shadow-sm hover:shadow-md hover:-translate-y-1 transition-all flex items-center gap-2"
            >
              <ImageIcon size={24} />
              我的画廊
            </button>
          </div>
        </div>

        <div>
          <h3 className="text-xl font-black text-gray-800 mb-4 flex items-center gap-2">
            <span className="text-2xl">🎨</span> 涂色模板
          </h3>
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            {TEMPLATES.map(t => (
              <button
                key={t.id}
                onClick={() => { setSelectedTemplate(t.id); setView('canvas'); }}
                className="bg-white p-6 rounded-3xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all flex flex-col items-center gap-3 border-4 border-transparent hover:border-purple-200 group"
              >
                <div 
                  className="w-24 h-24 opacity-80 group-hover:opacity-100 transition-opacity"
                  dangerouslySetInnerHTML={{ __html: t.svg }}
                />
                <span className="font-bold text-gray-700">{t.icon} {t.name}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  );

  const renderCanvas = () => {
    const template = selectedTemplate ? TEMPLATES.find(t => t.id === selectedTemplate) : null;
    
    return (
      <div className="flex-1 p-4 md:p-6 flex flex-col h-full overflow-hidden max-w-6xl mx-auto w-full">
        {/* 画布区域 */}
        <div className="flex-1 bg-white rounded-[2rem] shadow-xl overflow-hidden border-[6px] border-purple-200 touch-none relative cursor-crosshair">
           <canvas
            ref={canvasRef}
            className="absolute inset-0 w-full h-full z-10"
            onMouseDown={startDrawing}
            onMouseUp={stopDrawing}
            onMouseMove={draw}
            onMouseLeave={stopDrawing}
            onTouchStart={startDrawing}
            onTouchEnd={stopDrawing}
            onTouchMove={draw}
          />
          {/* 线稿浮层：使用正片叠底模式 */}
          {template && (
            <div 
              className="absolute inset-0 z-20 pointer-events-none mix-blend-multiply opacity-90 p-4 md:p-12 flex items-center justify-center"
            >
               <div 
                  className="w-full h-full max-w-md max-h-md mx-auto"
                  dangerouslySetInnerHTML={{ __html: template.svg }}
               />
            </div>
          )}
        </div>

        {/* 工具栏 */}
        <div className="mt-4 md:mt-6 bg-white p-4 md:p-6 rounded-[2rem] shadow-lg flex flex-col md:flex-row items-center justify-between shrink-0 gap-4">
          <div className="flex space-x-3 md:space-x-4 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 scrollbar-hide">
            {colors.map(c => (
              <button
                key={c}
                onClick={() => setColor(c)}
                className={`w-10 h-10 md:w-12 md:h-12 rounded-full border-[3px] shadow-sm flex-shrink-0 transition-transform ${
                  color === c ? 'border-gray-800 scale-110' : 'border-gray-200 hover:scale-105'
                }`}
                style={{ backgroundColor: c }}
              />
            ))}
          </div>

          <div className="flex items-center space-x-4 w-full md:w-auto bg-gray-50 p-3 rounded-xl">
             <div className="w-4 h-4 rounded-full bg-black" style={{ transform: 'scale(0.5)' }}></div>
             <input 
                type="range" min="2" max="40" value={lineWidth} 
                onChange={(e) => setLineWidth(parseInt(e.target.value))}
                className="w-full md:w-32 h-2 bg-gray-300 rounded-lg appearance-none cursor-pointer accent-purple-500"
              />
             <div className="w-8 h-8 rounded-full bg-black"></div>
          </div>
        </div>
      </div>
    );
  };

  const renderGallery = () => (
    <div className="flex-1 p-6 overflow-y-auto">
      <div className="max-w-6xl mx-auto">
        {gallery.length === 0 ? (
          <div className="text-center py-20">
            <div className="text-6xl mb-4">🖼️</div>
            <h3 className="text-2xl font-bold text-gray-500">画廊还是空的哦</h3>
            <p className="text-gray-400 mt-2 mb-8">快去创作你的第一幅画作吧！</p>
            <button 
              onClick={() => setView('home')}
              className="bg-purple-600 px-8 py-3 rounded-full font-bold text-white shadow hover:-translate-y-1 transition-all"
            >
              去创作
            </button>
          </div>
        ) : (
          <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {gallery.map(item => (
              <div key={item.id} className="bg-white rounded-3xl p-3 shadow-sm hover:shadow-md transition-shadow group relative">
                <img src={item.dataUrl} alt="Artwork" className="w-full aspect-square object-contain rounded-2xl bg-gray-50" />
                <div className="mt-3 flex justify-between items-center px-2">
                  <span className="text-sm font-bold text-gray-400">
                    {new Date(item.timestamp).toLocaleDateString()}
                  </span>
                  <div className="flex gap-2">
                    <a 
                      href={item.dataUrl} 
                      download={`youqizhi_art_${item.timestamp}.png`}
                      className="p-2 text-purple-500 hover:bg-purple-50 rounded-full transition-colors"
                      title="下载"
                    >
                      <Download size={18} />
                    </a>
                    <button 
                      onClick={() => deleteItem(item.id)}
                      className="p-2 text-red-400 hover:bg-red-50 rounded-full transition-colors"
                      title="删除"
                    >
                      <Trash2 size={18} />
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );

  return (
    <div className="h-screen bg-[#FAF5FF] flex flex-col overflow-hidden font-sans">
      <div className="p-4 flex items-center justify-between bg-white/80 backdrop-blur-md shadow-sm shrink-0 z-10">
        <div className="flex items-center">
          <button 
            onClick={() => {
              if (view === 'canvas') setView('home');
              else if (view === 'gallery') setView('home');
              else navigate('/');
            }} 
            className="bg-white p-2 md:p-3 rounded-full shadow hover:bg-purple-50"
          >
            <ArrowLeft className="text-gray-600" />
          </button>
          <h2 className="ml-4 text-xl md:text-2xl font-black text-gray-800">
            {view === 'home' ? '艺术创造' : view === 'canvas' ? '互动画板' : '我的画廊'}
          </h2>
        </div>
        <div className="flex space-x-2">
          {view === 'canvas' && (
            <>
              <button onClick={clearCanvas} className="p-2 md:p-3 bg-red-100 text-red-500 rounded-xl hover:bg-red-200 active:scale-95 transition-transform shadow-sm">
                <Trash2 size={24} />
              </button>
              <button onClick={handleSave} className="p-2 md:p-3 bg-green-100 text-green-600 rounded-xl hover:bg-green-200 active:scale-95 transition-transform shadow-sm flex items-center gap-1 font-bold">
                <Save size={24} />
                <span className="hidden md:inline">保存</span>
              </button>
            </>
          )}
        </div>
      </div>

      {view === 'home' && renderHome()}
      {view === 'canvas' && renderCanvas()}
      {view === 'gallery' && renderGallery()}
    </div>
  );
};
